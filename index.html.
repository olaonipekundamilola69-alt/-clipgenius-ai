<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#090b12">
<title>ClipGenius AI — Turn long videos into standout clips</title>
<style>
:root{--bg:#090b12;--panel:#111522;--panel2:#171d2d;--line:#252d40;--text:#f4f6fb;--muted:#9ba5ba;--purple:#8b5cf6;--cyan:#42d9ce;--pink:#f472b6}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at 80% -10%,#25204b 0,transparent 34%),var(--bg);color:var(--text);font:15px Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,sans-serif}
button,input,select{font:inherit}button{cursor:pointer}.shell{max-width:1180px;margin:auto;padding:22px 22px 60px}.top{display:flex;align-items:center;justify-content:space-between;gap:15px;margin-bottom:58px}.brand{display:flex;align-items:center;gap:11px;font-weight:800;font-size:19px;letter-spacing:-.5px}.logo{width:37px;height:37px;border-radius:12px;background:linear-gradient(135deg,var(--purple),var(--cyan));display:grid;place-items:center;color:#080b12;font-weight:1000;font-size:20px}.badge{border:1px solid #34314f;color:#c9b9ff;background:#17142a;padding:7px 11px;border-radius:30px;font-size:12px}
.hero{text-align:center;max-width:760px;margin:0 auto 38px}.eyebrow{color:var(--cyan);font-size:12px;font-weight:800;letter-spacing:2px;text-transform:uppercase}.hero h1{font-size:clamp(36px,7vw,62px);line-height:1.04;letter-spacing:-2.5px;margin:15px 0}.gradient{background:linear-gradient(90deg,#a78bfa,#4de3d6);-webkit-background-clip:text;background-clip:text;color:transparent}.hero p{color:var(--muted);font-size:17px;line-height:1.6;margin:0 auto;max-width:610px}
.workspace{max-width:790px;margin:0 auto;background:linear-gradient(180deg,#151a2a,#101421);border:1px solid var(--line);border-radius:22px;padding:22px;box-shadow:0 24px 80px #0006}.tabs{display:flex;gap:8px;margin-bottom:20px}.tab{border:1px solid var(--line);background:transparent;color:var(--muted);padding:10px 14px;border-radius:10px;font-size:13px}.tab.active{background:#282044;color:#e5dcff;border-color:#6c55a8}
.label{display:block;font-size:13px;color:#dce1ed;font-weight:650;margin:18px 0 9px}.urlbox{display:flex;gap:9px}.urlbox input,.field{width:100%;background:#0b0f19;border:1px solid #30394e;border-radius:11px;padding:14px;color:var(--text);outline:none}.urlbox input:focus,.field:focus{border-color:var(--purple)}.primary{border:0;border-radius:11px;padding:13px 18px;background:linear-gradient(110deg,var(--purple),#6556dc);color:white;font-weight:750;white-space:nowrap}.upload{margin-top:13px;border:1px dashed #46516b;background:#0d1220;border-radius:13px;padding:23px;text-align:center;color:var(--muted)}.upload strong{color:#e7eaf4;display:block;margin-bottom:5px}.upload input{display:none}.options{display:grid;grid-template-columns:1fr 1fr;gap:13px}.hint{font-size:12px;color:var(--muted);margin-top:8px}.status{display:none;margin-top:17px;padding:13px;border-radius:10px;background:#102b2a;border:1px solid #225653;color:#a8f4e9;font-size:13px;line-height:1.5}
.features{display:grid;grid-template-columns:repeat(3,1fr);gap:13px;max-width:950px;margin:48px auto 0}.feature{padding:18px;background:#111522;border:1px solid var(--line);border-radius:15px}.icon{font-size:22px}.feature h3{font-size:14px;margin:12px 0 6px}.feature p{font-size:12px;color:var(--muted);line-height:1.55;margin:0}.foot{text-align:center;color:#667087;font-size:12px;margin-top:48px}.preview{display:none;margin-top:18px;border:1px solid var(--line);border-radius:12px;padding:12px;color:var(--muted);font-size:13px}.preview video{width:100%;max-height:280px;border-radius:9px;margin-top:9px;background:#05070b}
@media(max-width:650px){.shell{padding:17px 14px 45px}.top{margin-bottom:43px}.workspace{padding:16px}.urlbox{flex-direction:column}.primary{width:100%}.features{grid-template-columns:1fr 1fr;margin-top:32px}.options{grid-template-columns:1fr}.hero h1{letter-spacing:-1.7px}.badge{font-size:10px}}
@media(max-width:390px){.features{grid-template-columns:1fr}}
</style>
</head>
<body>
<div class="shell">
<header class="top"><div class="brand"><div class="logo">▶</div>ClipGenius <span class="gradient">AI</span></div><div class="badge">EARLY ACCESS · MVP</div></header>
<section class="hero"><div class="eyebrow">Your content. More moments.</div><h1>Turn long videos into <span class="gradient">standout clips.</span></h1><p>Find the moments worth sharing, shape them for vertical video, and get your content ready for every platform.</p></section>
<main class="workspace">
<div class="tabs"><button class="tab active" id="linkTab">Paste a link</button><button class="tab" id="uploadTab">Upload a video</button></div>
<div id="linkPanel"><label class="label" for="videoUrl">Video URL</label><div class="urlbox"><input id="videoUrl" type="url" placeholder="Paste a public video link here…"><button class="primary" id="analyzeBtn">Find clips →</button></div><div class="hint">Add a video you own or have permission to edit. Link importing will be connected to the processing service in a later build.</div></div>
<div id="uploadPanel" style="display:none"><label class="label">Choose a video file</label><label class="upload" for="videoFile"><strong>＋ Tap to choose a video</strong>MP4, MOV or WebM · Select a file from your device<input id="videoFile" type="file" accept="video/mp4,video/quicktime,video/webm"></label></div>
<div class="options"><div><label class="label" for="clipStyle">Content type</label><select class="field" id="clipStyle"><option>Auto detect</option><option>Gaming & livestreams</option><option>Podcasts & interviews</option><option>Motivational</option><option>Education & tutorials</option><option>Commentary</option></select></div><div><label class="label" for="clipLength">Clip length</label><select class="field" id="clipLength"><option>30–60 seconds</option><option>15–30 seconds</option><option>60–90 seconds</option><option>Up to 3 minutes</option></select></div></div>
<div id="status" class="status"></div><div id="preview" class="preview"></div>
</main>
<section class="features">
<div class="feature"><div class="icon">✦</div><h3>Smart moment detection</h3><p>Find compelling sections using speech, context and scene changes.</p></div>
<div class="feature"><div class="icon">▤</div><h3>Animated captions</h3><p>Create readable, timed subtitles with customizable styles.</p></div>
<div class="feature"><div class="icon">▣</div><h3>Vertical reframing</h3><p>Prepare 9:16 layouts for Shorts, Reels and TikTok.</p></div>
<div class="feature"><div class="icon">◉</div><h3>Clip scoring</h3><p>Rank moments by hook strength, clarity and standalone value.</p></div>
<div class="feature"><div class="icon">✎</div><h3>Titles & descriptions</h3><p>Generate platform-ready titles, descriptions and hashtags.</p></div>
<div class="feature"><div class="icon">⇩</div><h3>Export-ready videos</h3><p>Review and download your finished clips in one workspace.</p></div>
</section>
<footer class="foot">ClipGenius AI · Independent project · Not affiliated with OpusClip</footer>
</div>
<script>
const linkTab=document.getElementById('linkTab'),uploadTab=document.getElementById('uploadTab');
const linkPanel=document.getElementById('linkPanel'),uploadPanel=document.getElementById('uploadPanel');
function switchTab(upload){linkPanel.style.display=upload?'none':'block';uploadPanel.style.display=upload?'block':'none';linkTab.classList.toggle('active',!upload);uploadTab.classList.toggle('active',upload)}
linkTab.onclick=()=>switchTab(false);uploadTab.onclick=()=>switchTab(true);
const statusBox=document.getElementById('status');
document.getElementById('analyzeBtn').onclick=()=>{const url=document.getElementById('videoUrl').value.trim();if(!url){statusBox.style.display='block';statusBox.textContent='Paste a video URL first.';return}try{new URL(url)}catch{statusBox.style.display='block';statusBox.textContent='That link does not look valid. Check it and try again.';return}statusBox.style.display='block';statusBox.textContent='Your link has been added to the prototype. The AI analysis and clip-generation backend is not connected yet; that is the next development stage.'};
document.getElementById('videoFile').onchange=(e)=>{const f=e.target.files[0];if(!f)return;const box=document.getElementById('preview');box.style.display='block';box.innerHTML='<strong style="color:#eef2ff">Selected video:</strong> '+f.name+'<br>'+Math.round(f.size/1024/1024)+' MB';if(f.type.startsWith('video/')){const v=document.createElement('video');v.controls=true;v.src=URL.createObjectURL(f);box.appendChild(v)}statusBox.style.display='block';statusBox.textContent='File selected successfully. Upload storage and AI processing will be connected in the next stage.'};
</script>
</body></html>
